#if NIO_EDITOR
using NioEngine;

// Builds bundle presets as scripts.
public static class PresetWriter
{
    public static bool Write(List<string> names, List<string> texts)
    {
        int count = names.Count();
        string o = "// Generated by Synth Lab: do not edit.\n";
        o += "// I know this is hacky af. Need to add proper engine support. Don't look too hard.\n";
        o += "public static class PresetData\n{\n";
        o += $"    public static int Count() {{ return {count}; }}\n\n";
        o += "    public static string Name(int index)\n    {\n";
        for (int i = 0; i < count; i++)
        {
            o += $"        if (index == {i}) {{ return " + Literal(names[i]) + "; }\n";
        }
        o += "        return \"\";\n    }\n\n";
        o += "    public static string Text(int index)\n    {\n";
        for (int i = 0; i < count; i++)
        {
            o += $"        if (index == {i}) {{ return Text{i}(); }}\n";
        }
        o += "        return \"\";\n    }\n";
        for (int i = 0; i < count; i++)
        {
            o += TextFunction(i, texts[i]);
        }
        o += "}\n";

        string dir = Path.Combine(Project.runtimeDirectory, "Assets/Presets");
        Directory.CreateDirectory(dir);
        return File.WriteAllText(Path.Combine(dir, "PresetData.ns"), o);
    }

    static string TextFunction(int index, string text)
    {
        string o = $"\n    static string Text{index}()\n    {{\n";
        o += "        string o = \"\";\n";
        byte[] bytes = UTF8.GetBytes(text);
        int at = 0;
        while (at < bytes.Length)
        {
            int end = at;
            while (end < bytes.Length && bytes[end] != '\n')
            {
                end++;
            }
            o += "        o += " + Literal(text.Substring(at, end - at) + "\n") + ";\n";
            at = end + 1;
        }
        return o + "        return o;\n    }\n";
    }

    static string Literal(string text)
    {
        byte[] b = UTF8.GetBytes(text);
        byte[] o = new byte[b.Length * 2 + 2];
        int n = 0;
        o[n++] = (byte)'"';
        for (int i = 0; i < b.Length; i++)
        {
            byte c = b[i];
            if (c == '\n' || c == '\t')
            {
                o[n++] = (byte)'\\';
                o[n++] = c == '\n' ? (byte)'n' : (byte)'t';
            }
            else if (c >= ' ')
            {
                if (c == '"' || c == '\\')
                {
                    o[n++] = (byte)'\\';
                }
                o[n++] = c;
            }
        }
        o[n++] = (byte)'"';
        byte[] exact = new byte[n];
        for (int i = 0; i < n; i++)
        {
            exact[i] = o[i];
        }
        return UTF8.GetString(exact);
    }
}
#endif
